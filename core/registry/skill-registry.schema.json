{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/skill-registry-v0.1.json",
  "title": "Personal AI OS Skill Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "skills"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "category", "capabilities", "triggers",
        "location", "scope", "publisher", "source", "version", "license",
        "trust_level", "status", "enabled", "installed", "dependencies",
        "conflicts", "recommended_agents", "activation_cost", "compatibility",
        "quality", "notes", "last_validated"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 20 },
        "category": { "type": "string", "minLength": 2 },
        "capabilities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "triggers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 4 }
        },
        "location": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["shared", "private", "external"] },
        "publisher": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "type"],
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "type": { "enum": ["personal", "vendor", "community"] }
          }
        },
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "uri"],
          "properties": {
            "type": { "enum": ["local", "repository", "bundled", "marketplace"] },
            "uri": { "type": "string", "minLength": 1 },
            "repository": { "type": ["string", "null"] },
            "commit": { "type": ["string", "null"] }
          }
        },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "license": { "type": "string", "minLength": 2 },
        "trust_level": { "enum": ["AUTHORITATIVE", "VERIFIED", "COMMUNITY", "EXPERIMENTAL", "DISABLED"] },
        "status": { "enum": ["AVAILABLE", "UNAVAILABLE", "DISABLED"] },
        "enabled": { "type": "boolean" },
        "installed": { "type": "boolean" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "optional"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "optional": { "type": "boolean" },
              "version": { "type": ["string", "null"] }
            }
          }
        },
        "conflicts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "recommended_agents": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "activation_cost": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "compatibility": {
          "type": "object", "additionalProperties": false,
          "required": ["runtime", "minimum_version"],
          "properties": {
            "runtime": { "const": "codex-agent-skills" },
            "minimum_version": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "quality": {
          "type": "object", "additionalProperties": false,
          "required": ["score", "maximum", "rubric_version"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 75 },
            "maximum": { "const": 75 },
            "rubric_version": { "const": "0.1.0" }
          }
        },
        "notes": { "type": "string" },
        "last_validated": { "type": "string", "format": "date" }
      }
    }
  }
}
